{
    "artifact_name": "DATA_PIPELINE_ARTIFACT",
    "version": "v1.0",
    "created_at": "2026-07-21 20:51:46",
    "dataset": "NASA C-MAPSS FD001",
    "pipeline_function": "run_data_pipeline()",
    "pipeline_steps": [
        "1. Load raw data (pm_train.csv, pm_test.csv)",
        "2. Remove constant features (s18, s19, setting3)",
        "3. Compute RUL per engine",
        "4. Engine-wise train/val split (80/20, seed=42)",
        "5. Clip RUL at 125 cycles",
        "6. Add rolling features (windows=5,20)",
        "7. Drop NaN rows from rolling window",
        "8. Save train_stage1.csv, val_stage1.csv, test_stage1.csv"
    ],
    "inputs": {
        "train_raw": "pm_train.csv",
        "test_raw": "pm_test.csv",
        "truth_raw": "pm_truth.csv"
    },
    "outputs": {
        "train": "train_stage1.csv",
        "val": "val_stage1.csv",
        "test": "test_stage1.csv"
    },
    "parameters": {
        "rul_clip": 125,
        "rolling_windows": [
            5,
            20
        ],
        "val_split_ratio": 0.2,
        "random_seed": 42,
        "constant_removed": [
            "s18",
            "s19",
            "setting3"
        ]
    },
    "output_schema": {
        "train_shape": [
            15259,
            98
        ],
        "val_shape": [
            3472,
            98
        ],
        "test_shape": [
            11196,
            97
        ],
        "feature_count": 95,
        "target": "RUL"
    }
}