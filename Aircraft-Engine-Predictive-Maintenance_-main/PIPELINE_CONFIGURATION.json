{
    "config_version": "v1.0",
    "created_at": "2026-07-21 20:51:46",
    "paths": {
        "train_raw": "pm_train.csv",
        "test_raw": "pm_test.csv",
        "truth_raw": "pm_truth.csv",
        "train_output": "train_stage1.csv",
        "val_output": "val_stage1.csv",
        "test_output": "test_stage1.csv"
    },
    "cleaning_rules": {
        "remove_constant_features": true,
        "constant_threshold": 0.0,
        "remove_near_zero_variance": true,
        "near_zero_threshold": 1e-06,
        "remove_duplicates": true,
        "handle_missing": "drop_rows"
    },
    "feature_engineering": {
        "rolling_windows": [
            5,
            20
        ],
        "rolling_functions": [
            "mean",
            "std"
        ],
        "base_feature_prefix": [
            "s",
            "setting"
        ]
    },
    "rul_settings": {
        "formula": "max_cycle - current_cycle",
        "clip_upper": 125,
        "clip_reason": "Engines healthy above 125 cycles"
    },
    "split_settings": {
        "strategy": "engine_wise",
        "val_ratio": 0.2,
        "random_seed": 42,
        "leakage_prevention": "GroupShuffleSplit by engine id"
    },
    "normalization": {
        "method": "StandardScaler",
        "fit_on": "train_only",
        "note": "Scaling applied in Stage 2 modeling notebook"
    }
}